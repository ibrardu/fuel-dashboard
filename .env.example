# Client-side (Next.js app) — safe to expose to the browser, read-only via
# Supabase RLS (anon key can only SELECT). See README "Supabase setup".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by scripts/backfill and scripts/ingest, NEVER exposed
# to the browser, NEVER prefixed NEXT_PUBLIC_. In CI these come from GitHub
# Actions repo secrets (Settings -> Secrets and variables -> Actions); only
# set them locally if you're running a backfill/ingest script by hand.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
